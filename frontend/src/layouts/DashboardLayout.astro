---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/ui/Sidebar.astro';
import Navbar from '../components/ui/Navbar.astro';
import Loader from '../components/ui/Loader.astro';

export interface Props {
  title?: string;
  pageTitle?: string;
}

const { title, pageTitle = 'Dashboard' } = Astro.props;
---
<BaseLayout title={title || pageTitle}>
  <Loader />
  <Sidebar />
  <div id="layout-wrapper" style="min-height: 100vh; display: flex; flex-direction: column;">
    <Navbar pageTitle={pageTitle} />
    <main id="main-content" style="padding: 64px 24px 24px 24px; flex: 1; background: #f7f9fb;">
      <slot />
    </main>
    <footer style="width: 100%; background: #f2f4f6; border-top: 1px solid #c3c6d7; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 8px 24px; gap: 8px; text-align: center;">
      <span style="font-size: 12px; color: #434655;">© 2024 Biblioteca Popular La Palabra. v2.4.0</span>
      <div style="display: flex; gap: 24px;">
        <a style="font-size: 12px; color: #434655;" href="#">Privacidad</a>
        <a style="font-size: 12px; color: #434655;" href="#">Soporte</a>
      </div>
    </footer>
  </div>

  <style>
    @media (min-width: 1024px) {
      #layout-wrapper { margin-left: 256px; }
      #main-content { padding-left: 24px !important; padding-right: 24px !important; }
    }
    @media (max-width: 1023px) {
      #layout-wrapper { margin-left: 0; }
      #main-content { padding-left: 16px !important; padding-right: 16px !important; }
    }
  </style>

  <script is:inline>
    (function() {
      const token = localStorage.getItem('accessToken');
      if (!token) { window.location.href = '/login'; }
    })();
  </script>
</BaseLayout>
