---
export interface Props {
  pageTitle?: string;
}
const { pageTitle = 'Dashboard' } = Astro.props;
---

<header id="app-navbar" class="fixed top-0 right-0 bg-surface border-b border-outline-variant shadow-sm flex justify-between items-center px-lg z-40 transition-all" style="height: 64px;">
  <div class="flex items-center gap-4">
    <button id="sidebar-toggle" class="lg:hidden p-2 text-on-surface-variant hover:text-primary transition-colors cursor-pointer border-0 bg-transparent">
      <span class="material-symbols-outlined">menu</span>
    </button>
    <h2 class="font-headline-md text-headline-md font-bold text-on-secondary-fixed">{pageTitle}</h2>
  </div>
  <div class="flex items-center gap-4">
    <div class="relative hidden lg:block">
      <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[20px]">search</span>
      <input id="global-search" class="lg:w-64 w-40 bg-surface-container-low border border-outline-variant rounded-full px-4 py-1.5 pl-10 font-body-md text-body-md focus:ring-2 focus:ring-primary focus:border-primary transition-all outline-none" placeholder="Buscar..." type="text" />
    </div>
    <div class="flex items-center gap-2">
      <button class="p-2 text-on-surface-variant hover:text-primary transition-opacity cursor-pointer border-0 bg-transparent" title="Notificaciones">
        <span class="material-symbols-outlined">notifications</span>
      </button>
      <div class="h-8 w-px bg-outline-variant mx-1"></div>
      <div class="flex items-center gap-2 cursor-pointer group">
        <div class="w-8 h-8 rounded-full bg-primary-fixed text-primary flex items-center justify-center font-bold text-xs" id="user-avatar-initial">A</div>
        <span class="font-label-md text-label-md text-on-surface-variant group-hover:text-primary transition-colors" id="user-display-name">Admin</span>
        <span class="material-symbols-outlined text-outline text-[18px]">expand_more</span>
      </div>
    </div>
  </div>
</header>

<style>
  @media (min-width: 1024px) {
    #app-navbar { width: calc(100% - 256px); }
  }
  @media (max-width: 1023px) {
    #app-navbar { width: 100%; }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    const user = JSON.parse(localStorage.getItem('user') || '{}');
    if (user.nombre) {
      const nameEl = document.getElementById('user-display-name');
      const avatarEl = document.getElementById('user-avatar-initial');
      if (nameEl) nameEl.textContent = user.nombre.split(' ')[0];
      if (avatarEl) avatarEl.textContent = user.nombre.charAt(0).toUpperCase();
    }

    document.getElementById('sidebar-toggle')?.addEventListener('click', function() {
      document.getElementById('sidebar')?.classList.toggle('open');
    });
  });
</script>
