---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Iniciar Sesión">
  <div class="login-page">
    <div class="login-card">
      <div class="login-header">
        <div class="login-logo">📚</div>
        <h1 class="login-title">La Palabra</h1>
        <p class="login-subtitle">Sistema de Gestión Bibliotecaria</p>
      </div>

      <div
        id="login-error"
        class="alert alert-danger d-flex align-items-center gap-2 mb-4"
        role="alert"
        style="display:none!important; font-size:13px;"
      >
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
        <span></span>
      </div>

      <form id="login-form" novalidate>
        <div class="mb-3">
          <label for="email" class="form-label">
            <i class="bi bi-envelope me-1" style="color:var(--color-text-muted)"></i>
            Correo electrónico
          </label>
          <input
            type="email"
            class="form-control"
            id="email"
            placeholder="usuario@biblioteca.com"
            autocomplete="email"
            required
          />
        </div>

        <div class="mb-4">
          <label for="password" class="form-label">
            <i class="bi bi-lock me-1" style="color:var(--color-text-muted)"></i>
            Contraseña
          </label>
          <div class="input-group">
            <input
              type="password"
              class="form-control"
              id="password"
              placeholder="••••••••"
              autocomplete="current-password"
              required
            />
            <button
              class="btn btn-outline-secondary"
              type="button"
              id="toggle-password"
              tabindex="-1"
            >
              <i class="bi bi-eye" id="toggle-icon"></i>
            </button>
          </div>
        </div>

        <button type="submit" class="btn btn-primary w-100" id="btn-submit" style="height:44px;">
          <i class="bi bi-box-arrow-in-right me-2"></i>
          Iniciar Sesión
        </button>
      </form>

      <p class="text-center mt-4 mb-0" style="font-size:12px; color:var(--color-text-muted);">
        ¿Problemas para acceder? Contacta al administrador del sistema.
      </p>

      <!-- Credenciales demo -->
      <div class="mt-4 p-3 rounded" style="background:var(--color-bg); font-size:12px;">
        <p class="fw-semibold mb-1" style="color:var(--color-text-muted);">Credenciales de prueba:</p>
        <p class="mb-0" style="color:var(--color-text);">
          <strong>Admin:</strong> admin@biblioteca.com / Admin2024!
        </p>
        <p class="mb-0" style="color:var(--color-text);">
          <strong>Biblioteca:</strong> bibliotecario@biblioteca.com / Biblio2024!
        </p>
      </div>
    </div>
  </div>

  <script src="../scripts/auth.js"></script>
  <script is:inline>
    // Toggle mostrar contraseña
    document.getElementById('toggle-password')?.addEventListener('click', function() {
      const input = document.getElementById('password');
      const icon = document.getElementById('toggle-icon');
      if (input.type === 'password') {
        input.type = 'text';
        icon.classList.replace('bi-eye', 'bi-eye-slash');
      } else {
        input.type = 'password';
        icon.classList.replace('bi-eye-slash', 'bi-eye');
      }
    });

    // Mostrar error correctamente
    const errorDiv = document.getElementById('login-error');
    if (errorDiv) {
      const original = errorDiv.querySelector('span');
      Object.defineProperty(errorDiv, 'textContent', {
        set: function(val) { if (original) original.textContent = val; }
      });
    }
  </script>
</BaseLayout>