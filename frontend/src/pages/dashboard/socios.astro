---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---
<DashboardLayout pageTitle="Gestión de Socios">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 mb-4">
    <div>
      <h2 class="text-xl font-semibold">Base de Datos de Socios</h2>
      <p class="text-sm text-gray-500">Administra el padrón histórico y las membresías activas.</p>
    </div>
    <button id="btn-nuevo-socio" class="bg-blue-700 text-white px-4 py-2 rounded-lg flex items-center gap-2 shrink-0">
      <span class="material-symbols-outlined text-lg">person_add</span>
      <span class="text-sm font-medium">Nuevo Socio</span>
    </button>
  </div>

  <div class="bg-white rounded-xl border p-4 mb-4">
    <div class="flex flex-wrap items-end gap-4">
      <div>
        <label class="text-xs font-semibold text-gray-500 uppercase block mb-1">Búsqueda</label>
        <input type="text" id="filtro-search" class="border rounded-lg px-3 py-2 text-sm w-48" placeholder="Nombre, DNI o email..." />
      </div>
      <div>
        <label class="text-xs font-semibold text-gray-500 uppercase block mb-1">Estado</label>
        <div class="flex flex-wrap gap-3">
          <label class="flex items-center gap-1 text-sm cursor-pointer"><input type="checkbox" checked id="filtro-activo" /> Activo</label>
          <label class="flex items-center gap-1 text-sm cursor-pointer"><input type="checkbox" id="filtro-inactivo" /> Inactivo</label>
          <label class="flex items-center gap-1 text-sm cursor-pointer"><input type="checkbox" id="filtro-moroso" /> Moroso</label>
          <label class="flex items-center gap-1 text-sm cursor-pointer"><input type="checkbox" id="filtro-suspendido" /> Suspendido</label>
        </div>
      </div>
      <div class="flex gap-2">
        <button id="btn-filtrar" class="bg-blue-700 text-white px-4 py-2 rounded-lg text-sm">Filtrar</button>
        <button id="btn-limpiar-filtros" class="border px-4 py-2 rounded-lg text-sm">Limpiar</button>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl border overflow-hidden">
    <div style="overflow-x: auto;">
      <table class="w-full" style="min-width: 700px;">
        <thead class="bg-gray-50 border-b">
          <tr>
            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Nombre del Socio</th>
            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase">DNI / ID</th>
            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Contacto</th>
            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Préstamos</th>
            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Estado</th>
            <th class="text-right px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y" id="tbody-socios">
          <tr>
            <td colspan="6" class="px-4 py-8 text-center text-gray-400">
              <span class="material-symbols-outlined animate-spin inline-block">sync</span> Cargando socios...
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <div class="px-4 py-3 bg-gray-50 border-t flex justify-between items-center" id="paginacion-container">
      <span class="text-sm text-gray-500" id="paginacion-info">Cargando...</span>
      <div class="flex items-center gap-2" id="paginacion-btns"></div>
    </div>
  </div>

  <!-- Modal -->
  <div class="modal-backdrop modal-hidden" id="modalSocioBackdrop">
    <div class="bg-white w-full max-w-2xl rounded-xl border">
      <div class="px-6 py-4 bg-blue-800 text-white flex justify-between items-center">
        <div>
          <h2 class="text-lg font-semibold" id="modal-title-socio">Registrar Nuevo Socio</h2>
          <p class="text-sm opacity-80">Complete la información del nuevo miembro</p>
        </div>
        <button class="text-white border-0 bg-transparent cursor-pointer modal-close material-symbols-outlined">close</button>
      </div>
      <form id="form-socio" class="p-6 space-y-4">
        <input type="hidden" id="socio-id" />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium mb-1">Nombre <span class="text-red-500">*</span></label>
            <input type="text" id="socio-nombre" class="w-full border rounded-lg px-3 py-2 text-sm" required />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Apellido <span class="text-red-500">*</span></label>
            <input type="text" id="socio-apellido" class="w-full border rounded-lg px-3 py-2 text-sm" required />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">DNI <span class="text-red-500">*</span></label>
            <input type="text" id="socio-dni" class="w-full border rounded-lg px-3 py-2 text-sm" required />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Email</label>
            <input type="email" id="socio-email" class="w-full border rounded-lg px-3 py-2 text-sm" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Teléfono</label>
            <input type="tel" id="socio-telefono" class="w-full border rounded-lg px-3 py-2 text-sm" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Fecha de Nacimiento</label>
            <input type="date" id="socio-fechanac" class="w-full border rounded-lg px-3 py-2 text-sm" />
          </div>
          <div class="md:col-span-2">
            <label class="block text-sm font-medium mb-1">Dirección</label>
            <input type="text" id="socio-direccion" class="w-full border rounded-lg px-3 py-2 text-sm" />
          </div>
        </div>
        <div class="flex justify-end gap-3 pt-4 border-t">
          <button type="button" class="px-4 py-2 border rounded-lg text-sm modal-close">Cancelar</button>
          <button type="submit" class="px-6 py-2 bg-blue-700 text-white rounded-lg text-sm">Guardar Socio</button>
        </div>
      </form>
    </div>
  </div>
</DashboardLayout>

<script src="../../scripts/socios.js"></script>
