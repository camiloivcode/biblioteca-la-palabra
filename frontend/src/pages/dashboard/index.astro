---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---
<DashboardLayout pageTitle="Dashboard" breadcrumb="Inicio">

  <!-- Stats Row -->
  <div class="row g-3 gap-section" id="stats-container">
    <!-- Se cargan dinámicamente -->
    <div class="col-12 text-center py-4">
      <div class="spinner-border text-primary" role="status"></div>
    </div>
  </div>

  <div class="row g-3">
    <!-- Préstamos activos recientes -->
    <div class="col-lg-8">
      <div class="card">
        <div class="card-header">
          <h6 class="card-title mb-0">
            <i class="bi bi-arrow-left-right me-2" style="color:var(--color-primary);"></i>
            Préstamos Activos
          </h6>
          <a href="/dashboard/prestamos" class="btn btn-sm btn-outline-primary">Ver todos</a>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover mb-0" id="tabla-prestamos-activos">
              <thead>
                <tr>
                  <th>Socio</th>
                  <th>Material</th>
                  <th>Vencimiento</th>
                  <th>Estado</th>
                </tr>
              </thead>
              <tbody id="tbody-prestamos"></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- Socios morosos -->
    <div class="col-lg-4">
      <div class="card">
        <div class="card-header">
          <h6 class="card-title mb-0">
            <i class="bi bi-exclamation-triangle me-2" style="color:var(--color-danger);"></i>
            Socios en Mora
          </h6>
        </div>
        <div class="card-body p-0">
          <div id="lista-morosos" style="max-height:340px; overflow-y:auto;"></div>
        </div>
      </div>
    </div>
  </div>

</DashboardLayout>

<script is:inline>
async function loadDashboard() {
  try {
    const data = await api.get('/reportes/dashboard');
    const { socios, materiales, prestamos } = data.data;
    document.getElementById('stats-container').innerHTML = `
      <div class="col-xl-2 col-md-4 col-6">
        <div class="stat-card"><div class="stat-icon blue"><i class="bi bi-people"></i></div><div><div class="stat-label">Total Socios</div><div class="stat-value">${socios.total}</div><div class="stat-change negative">${socios.morosos} en mora</div></div></div>
      </div>
      <div class="col-xl-2 col-md-4 col-6">
        <div class="stat-card"><div class="stat-icon green"><i class="bi bi-person-check"></i></div><div><div class="stat-label">Socios Activos</div><div class="stat-value">${socios.activos}</div></div></div>
      </div>
      <div class="col-xl-2 col-md-4 col-6">
        <div class="stat-card"><div class="stat-icon amber"><i class="bi bi-book"></i></div><div><div class="stat-label">Total Materiales</div><div class="stat-value">${materiales.total}</div></div></div>
      </div>
      <div class="col-xl-2 col-md-4 col-6">
        <div class="stat-card"><div class="stat-icon teal"><i class="bi bi-book-fill"></i></div><div><div class="stat-label">Disponibles</div><div class="stat-value">${materiales.disponibles}</div></div></div>
      </div>
      <div class="col-xl-2 col-md-4 col-6">
        <div class="stat-card"><div class="stat-icon purple"><i class="bi bi-arrow-left-right"></i></div><div><div class="stat-label">Préstamos Activos</div><div class="stat-value">${prestamos.activos}</div></div></div>
      </div>
      <div class="col-xl-2 col-md-4 col-6">
        <div class="stat-card"><div class="stat-icon red"><i class="bi bi-clock-history"></i></div><div><div class="stat-label">Devol. Hoy</div><div class="stat-value">${prestamos.devoluccionesHoy}</div></div></div>
      </div>
    `;
  } catch (e) { console.error('Error cargando dashboard:', e); }
}

async function loadPrestamosActivos() {
  try {
    const data = await api.get('/reportes/prestamos-activos');
    const tbody = document.getElementById('tbody-prestamos');
    if (!data.data.length) { tbody.innerHTML = '<tr><td colspan="4" class="text-center py-4 text-muted">No hay préstamos activos</td></tr>'; return; }
    const hoy = new Date();
    tbody.innerHTML = data.data.slice(0, 8).map(p => {
      const vence = new Date(p.fechaDevolucion);
      const dias = Math.ceil((vence - hoy) / (1000 * 60 * 60 * 24));
      const badge = p.estado === 'MORA' || dias <= 3 ? 'badge-mora' : 'badge-activo';
      return `<tr><td><div class="fw-semibold">${p.socio.apellido}, ${p.socio.nombre}</div><div class="text-muted-sm">DNI: ${p.socio.dni}</div></td><td><div>${p.material.titulo}</div><div class="text-muted-sm">${p.material.tipo}</div></td><td><div>${formatDate(p.fechaDevolucion)}</div><div class="text-muted-sm">${dias > 0 ? dias + ' días restantes' : 'Vencido'}</div></td><td>${estadoBadge(p.estado)}</td></tr>`;
    }).join('');
  } catch (e) { console.error('Error cargando préstamos:', e); }
}

async function loadMorosos() {
  try {
    const data = await api.get('/reportes/socios-morosos');
    const container = document.getElementById('lista-morosos');
    if (!data.data.length) { container.innerHTML = '<div class="p-3 text-center" style="font-size:13px;color:var(--color-success);">✓ No hay socios en mora</div>'; return; }
    container.innerHTML = data.data.map(s => `
      <div class="d-flex align-items-center gap-3 px-3 py-2" style="border-bottom:1px solid var(--color-border);">
        <div class="user-avatar" style="background:var(--color-danger);font-size:12px;width:32px;height:32px;">${s.apellido.charAt(0)}</div>
        <div class="flex-grow-1"><div class="fw-semibold" style="font-size:13px;">${s.apellido}, ${s.nombre}</div><div class="text-muted-sm">DNI: ${s.dni} · ${s.prestamos.length} en mora</div></div>
      </div>
    `).join('');
  } catch (e) { console.error('Error cargando morosos:', e); }
}

document.addEventListener('DOMContentLoaded', function() { loadDashboard(); loadPrestamosActivos(); loadMorosos(); });
</script>