---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---
<DashboardLayout pageTitle="Categorías" breadcrumb="Categorías">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h5 class="mb-1">Categorías</h5>
      <p class="text-muted mb-0" style="font-size:13px;">Organiza el catálogo por categorías</p>
    </div>
    <button class="btn btn-primary" id="btn-nueva-cat">
      <i class="bi bi-plus-circle me-2"></i>Nueva Categoría
    </button>
  </div>

  <div class="row g-3" id="grid-categorias">
    <div class="col-12 text-center py-5">
      <div class="spinner-border text-primary"></div>
    </div>
  </div>
</DashboardLayout>

<!-- Modal Categoría -->
<div class="modal fade" id="modalCat" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-semibold" id="modal-title-cat">
          <i class="bi bi-tag me-2"></i>Nueva Categoría
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="cat-id" />
        <div class="mb-3">
          <label class="form-label">Nombre <span class="text-danger">*</span></label>
          <input type="text" class="form-control" id="cat-nombre" placeholder="Ej: Literatura" required />
        </div>
        <div class="mb-3">
          <label class="form-label">Descripción</label>
          <textarea class="form-control" id="cat-desc" rows="3" placeholder="Descripción breve..."></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-primary" id="btn-guardar-cat">
          <i class="bi bi-check-circle me-2"></i>Guardar
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
const API = 'http://localhost:4000/api';
let editingCatId = null;
let modalCat;
const ICONS = ['bi-book', 'bi-journal', 'bi-globe', 'bi-music-note', 'bi-cpu', 'bi-flask', 'bi-brush', 'bi-camera', 'bi-tree', 'bi-heart'];
const COLORS = ['blue', 'green', 'amber', 'red', 'purple', 'teal', 'blue', 'amber', 'green', 'red'];

function hCat() {
  return { 'Content-Type': 'application/json', Authorization: `Bearer ${localStorage.getItem('accessToken')}` };
}

async function cargarCategorias() {
  const res = await fetch(`${API}/categorias`, { headers: hCat() });
  const data = await res.json();
  const grid = document.getElementById('grid-categorias');

  if (!data.success || !data.data.length) {
    grid.innerHTML = '<div class="col-12 text-center py-5 text-muted">No hay categorías registradas</div>';
    return;
  }

  grid.innerHTML = data.data.map((c, i) => `
    <div class="col-xl-3 col-md-4 col-sm-6">
      <div class="card h-100">
        <div class="card-body">
          <div class="d-flex align-items-start justify-content-between mb-3">
            <div class="stat-icon ${COLORS[i % COLORS.length]}">
              <i class="bi ${ICONS[i % ICONS.length]}"></i>
            </div>
            <div class="d-flex gap-1">
              <button class="btn btn-icon btn-sm btn-outline-primary" onclick="editarCat(${c.id})" title="Editar">
                <i class="bi bi-pencil"></i>
              </button>
              <button class="btn btn-icon btn-sm btn-outline-danger" onclick="eliminarCat(${c.id}, '${c.nombre}')" title="Eliminar">
                <i class="bi bi-trash"></i>
              </button>
            </div>
          </div>
          <h6 class="fw-semibold mb-1">${c.nombre}</h6>
          <p class="text-muted-sm mb-2">${c.descripcion || 'Sin descripción'}</p>
          <div class="text-muted-sm">
            <i class="bi bi-book me-1"></i>${c._count?.materiales ?? 0} materiales
          </div>
        </div>
      </div>
    </div>
  `).join('');
}

async function editarCat(id) {
  showLoader();
  const res = await fetch(`${API}/categorias/${id}`, { headers: hCat() });
  const data = await res.json();
  hideLoader();
  if (!data.success) return;

  editingCatId = id;
  document.getElementById('cat-id').value = data.data.id;
  document.getElementById('cat-nombre').value = data.data.nombre;
  document.getElementById('cat-desc').value = data.data.descripcion || '';
  document.getElementById('modal-title-cat').innerHTML = '<i class="bi bi-pencil me-2"></i>Editar Categoría';
  modalCat.show();
}

async function eliminarCat(id, nombre) {
  const result = await Swal.fire({
    title: '¿Eliminar categoría?',
    html: `Se eliminará <strong>${nombre}</strong>.`,
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#c02d2d',
    confirmButtonText: 'Eliminar',
    cancelButtonText: 'Cancelar',
  });
  if (!result.isConfirmed) return;

  showLoader();
  const res = await fetch(`${API}/categorias/${id}`, { method: 'DELETE', headers: hCat() });
  const data = await res.json();
  hideLoader();

  if (!data.success) return Swal.fire({ icon: 'error', title: 'Error', text: data.message });
  Swal.fire({ icon: 'success', title: 'Categoría eliminada', timer: 1500, showConfirmButton: false });
  cargarCategorias();
}

document.addEventListener('DOMContentLoaded', function () {
  modalCat = new bootstrap.Modal(document.getElementById('modalCat'));
  cargarCategorias();

  document.getElementById('btn-nueva-cat')?.addEventListener('click', function () {
    editingCatId = null;
    document.getElementById('cat-id').value = '';
    document.getElementById('cat-nombre').value = '';
    document.getElementById('cat-desc').value = '';
    document.getElementById('modal-title-cat').innerHTML = '<i class="bi bi-tag me-2"></i>Nueva Categoría';
    modalCat.show();
  });

  document.getElementById('btn-guardar-cat')?.addEventListener('click', async function () {
    const nombre = document.getElementById('cat-nombre').value.trim();
    if (!nombre) return Swal.fire({ icon: 'warning', title: 'Campo requerido', text: 'El nombre es obligatorio.' });

    const body = { nombre, descripcion: document.getElementById('cat-desc').value.trim() || null };

    showLoader();
    const isEdit = !!editingCatId;
    const url = isEdit ? `${API}/categorias/${editingCatId}` : `${API}/categorias`;
    const res = await fetch(url, { method: isEdit ? 'PUT' : 'POST', headers: hCat(), body: JSON.stringify(body) });
    const data = await res.json();
    hideLoader();

    if (!data.success) return Swal.fire({ icon: 'error', title: 'Error', text: data.message });
    modalCat.hide();
    Swal.fire({ icon: 'success', title: isEdit ? 'Categoría actualizada' : 'Categoría creada', timer: 1500, showConfirmButton: false });
    cargarCategorias();
  });
});

window.editarCat = editarCat;
window.eliminarCat = eliminarCat;
</script>