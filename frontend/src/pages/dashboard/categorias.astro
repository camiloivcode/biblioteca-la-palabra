---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---
<DashboardLayout pageTitle="Categorías" breadcrumb="Categorías">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h5 class="mb-1">Categorías</h5>
      <p class="text-muted mb-0" style="font-size:13px;">Organiza el catálogo por categorías</p>
    </div>
    <button class="btn btn-primary" id="btn-nueva-cat">
      <i class="bi bi-plus-circle me-2"></i>Nueva Categoría
    </button>
  </div>

  <div class="row g-3" id="grid-categorias">
    <div class="col-12 text-center py-5">
      <div class="spinner-border text-primary"></div>
    </div>
  </div>
</DashboardLayout>

<!-- Modal Categoría -->
<div class="modal fade" id="modalCat" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-semibold" id="modal-title-cat">
          <i class="bi bi-tag me-2"></i>Nueva Categoría
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="cat-id" />
        <div class="mb-3">
          <label class="form-label">Nombre <span class="text-danger">*</span></label>
          <input type="text" class="form-control" id="cat-nombre" placeholder="Ej: Literatura" required />
        </div>
        <div class="mb-3">
          <label class="form-label">Descripción</label>
          <textarea class="form-control" id="cat-desc" rows="3" placeholder="Descripción breve..."></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-primary" id="btn-guardar-cat">
          <i class="bi bi-check-circle me-2"></i>Guardar
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
let editingCatId = null;
let modalCat;

const iconMap = {
  Literatura: { icon: 'bi-book-half', color: 'amber' },
  Historia: { icon: 'bi-hourglass-split', color: 'blue' },
  Ciencias: { icon: 'bi-flask', color: 'green' },
  'Filosofía': { icon: 'bi-lightbulb', color: 'purple' },
  Arte: { icon: 'bi-palette', color: 'red' },
  Tecnología: { icon: 'bi-cpu', color: 'teal' },
  Matemáticas: { icon: 'bi-calculator', color: 'blue' },
  Geografía: { icon: 'bi-globe-americas', color: 'green' },
  Música: { icon: 'bi-music-note-beamed', color: 'amber' },
  Deportes: { icon: 'bi-trophy', color: 'red' },
};
const fallbacks = [{ icon: 'bi-bookmark', color: 'blue' }, { icon: 'bi-journal-text', color: 'green' }, { icon: 'bi-archive', color: 'amber' }, { icon: 'bi-collection', color: 'purple' }];

async function cargarCategorias() {
  try {
    const data = await api.get('/categorias');
    const grid = document.getElementById('grid-categorias');
    if (!data.data.length) { grid.innerHTML = '<div class="col-12 text-center py-5 text-muted"><i class="bi bi-tags fs-3 d-block mb-2"></i>No hay categorías registradas</div>'; return; }
    grid.innerHTML = data.data.map((c, i) => {
      const m = iconMap[c.nombre] || fallbacks[i % fallbacks.length];
      return `<div class="col-xl-3 col-md-4 col-sm-6">
        <div class="card h-100"><div class="card-body">
          <div class="d-flex align-items-start justify-content-between mb-3">
            <div class="stat-icon ${m.color}"><i class="bi ${m.icon}"></i></div>
            <div class="d-flex gap-1">
              <button class="btn btn-icon btn-sm btn-outline-primary" onclick="editarCat(${c.id})" title="Editar"><i class="bi bi-pencil"></i></button>
              <button class="btn btn-icon btn-sm btn-outline-danger" onclick="eliminarCat(${c.id}, '${c.nombre}')" title="Eliminar"><i class="bi bi-trash"></i></button>
            </div>
          </div>
          <h6 class="fw-semibold mb-1">${c.nombre}</h6>
          <p class="text-muted-sm mb-2">${c.descripcion || 'Sin descripción'}</p>
          <div class="text-muted-sm"><i class="bi bi-book me-1"></i>${c._count?.materiales ?? 0} materiales</div>
        </div></div>
      </div>`;
    }).join('');
  } catch (err) { console.error(err); }
}

async function editarCat(id) {
  showLoader();
  try {
    const res = await fetch(`${window.API_URL}/categorias/${id}`, { headers: getHeaders() });
    const d = await res.json();
    if (!d.success) throw new Error(d.message);
    editingCatId = id;
    document.getElementById('cat-id').value = d.data.id;
    document.getElementById('cat-nombre').value = d.data.nombre;
    document.getElementById('cat-desc').value = d.data.descripcion || '';
    document.getElementById('modal-title-cat').innerHTML = '<i class="bi bi-pencil me-2"></i>Editar Categoría';
    modalCat.show();
  } catch (err) { showToast('error', err.message); }
  finally { hideLoader(); }
}

async function eliminarCat(id, nombre) {
  const result = await Swal.fire({ title: '¿Eliminar categoría?', html: `Se eliminará <strong>${nombre}</strong>.`, icon: 'warning', showCancelButton: true, confirmButtonColor: '#ef4444', confirmButtonText: 'Eliminar', cancelButtonText: 'Cancelar' });
  if (!result.isConfirmed) return;
  showLoader();
  try {
    await api.del(`/categorias/${id}`);
    showToast('success', 'Categoría eliminada');
    cargarCategorias();
  } catch (err) { showToast('error', err.message); }
  finally { hideLoader(); }
}

document.addEventListener('DOMContentLoaded', function () {
  modalCat = new bootstrap.Modal(document.getElementById('modalCat'));
  cargarCategorias();
  document.getElementById('btn-nueva-cat')?.addEventListener('click', function () {
    editingCatId = null;
    document.getElementById('cat-id').value = '';
    document.getElementById('cat-nombre').value = '';
    document.getElementById('cat-desc').value = '';
    document.getElementById('modal-title-cat').innerHTML = '<i class="bi bi-tag me-2"></i>Nueva Categoría';
    modalCat.show();
  });
  document.getElementById('btn-guardar-cat')?.addEventListener('click', async function () {
    const nombre = document.getElementById('cat-nombre').value.trim();
    if (!nombre) return Swal.fire({ icon: 'warning', title: 'Campo requerido', text: 'El nombre es obligatorio.' });
    showLoader();
    try {
      const isEdit = !!editingCatId;
      isEdit ? await api.put(`/categorias/${editingCatId}`, { nombre, descripcion: document.getElementById('cat-desc').value.trim() || null }) : await api.post('/categorias', { nombre, descripcion: document.getElementById('cat-desc').value.trim() || null });
      modalCat.hide();
      showToast('success', isEdit ? 'Categoría actualizada' : 'Categoría creada');
      cargarCategorias();
    } catch (err) { showToast('error', err.message); }
    finally { hideLoader(); }
  });
});
window.editarCat = editarCat;
window.eliminarCat = eliminarCat;
</script>