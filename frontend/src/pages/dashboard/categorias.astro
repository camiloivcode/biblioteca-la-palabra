---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---
<DashboardLayout pageTitle="Módulo de Categorías">
  <!-- Stats Overview -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter mb-lg">
    <div class="bg-white p-6 rounded-xl border border-outline-variant shadow-sm">
      <div class="flex items-center justify-between mb-3">
        <h3 class="font-label-md text-label-md uppercase text-secondary tracking-wider">Total Categorías</h3>
        <span class="material-symbols-outlined text-primary">category</span>
      </div>
      <p class="font-display text-[32px] text-on-surface font-bold" id="stat-cat-total">—</p>
    </div>
    <div class="bg-white p-6 rounded-xl border border-outline-variant shadow-sm">
      <div class="flex items-center justify-between mb-3">
        <h3 class="font-label-md text-label-md uppercase text-secondary tracking-wider">Con Materiales</h3>
        <span class="material-symbols-outlined text-tertiary-container">inventory_2</span>
      </div>
      <p class="font-display text-[32px] text-on-surface font-bold" id="stat-cat-con">—</p>
    </div>
    <div class="bg-white p-6 rounded-xl border border-outline-variant shadow-sm">
      <div class="flex items-center justify-between mb-3">
        <h3 class="font-label-md text-label-md uppercase text-secondary tracking-wider">Más Usada</h3>
        <span class="material-symbols-outlined text-primary">star</span>
      </div>
      <p class="font-display text-[20px] text-on-surface font-bold" id="stat-cat-mas">—</p>
    </div>
  </div>

  <!-- Category Cards Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-gutter" id="grid-categorias">
    <div class="col-span-full text-center py-lg">
      <span class="material-symbols-outlined animate-spin text-primary">sync</span>
    </div>
  </div>

  <!-- Modal Categoría -->
  <div class="modal-backdrop modal-hidden" id="modalCatBackdrop">
    <div class="bg-surface-container-lowest w-full max-w-md rounded-xl shadow-2xl overflow-hidden border border-outline-variant">
      <div class="px-xl py-lg bg-primary-container text-on-primary flex justify-between items-center">
        <div>
          <h2 class="font-headline-md text-headline-md" id="modal-title-cat">Nueva Categoría</h2>
          <p class="font-body-md opacity-90">Agrega una nueva categoría al catálogo</p>
        </div>
        <button class="material-symbols-outlined hover:bg-white/10 p-2 rounded-full transition-colors border-0 bg-transparent text-on-primary cursor-pointer modal-close-cat">close</button>
      </div>
      <form id="form-cat" class="p-xl space-y-lg">
        <input type="hidden" id="cat-id" />
        <input type="hidden" id="cat-icono" value="category" />
        <div>
          <label class="block font-label-md text-label-md text-on-surface-variant mb-xs">Nombre <span class="text-error">*</span></label>
          <input type="text" id="cat-nombre" class="w-full p-md border border-outline-variant rounded-lg bg-white focus:ring-2 focus:ring-primary focus:border-primary transition-all font-body-md outline-none" placeholder="Ej: Literatura" required />
        </div>
        <div>
          <label class="block font-label-md text-label-md text-on-surface-variant mb-xs">Descripción</label>
          <textarea id="cat-desc" class="w-full p-md border border-outline-variant rounded-lg bg-white focus:ring-2 focus:ring-primary focus:border-primary transition-all font-body-md outline-none resize-none" placeholder="Descripción breve..." rows="3"></textarea>
        </div>
        <div>
          <label class="block font-label-md text-label-md text-on-surface-variant mb-xs">Icono</label>
          <div class="flex flex-wrap gap-2" id="icon-selector"></div>
        </div>
        <div class="flex justify-end gap-md pt-lg border-t border-outline-variant">
          <button type="button" class="px-lg py-sm border border-secondary text-secondary rounded-lg font-title-lg hover:bg-secondary-container/10 transition-all modal-close-cat">Cancelar</button>
          <button type="submit" class="px-2xl py-sm bg-primary text-on-primary rounded-lg font-title-lg hover:shadow-lg active:scale-95 transition-all shadow-md">Guardar</button>
        </div>
      </form>
    </div>
  </div>
</DashboardLayout>

<script src="../../scripts/categorias.js"></script>
