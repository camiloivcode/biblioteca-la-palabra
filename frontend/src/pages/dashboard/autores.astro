---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---
<DashboardLayout pageTitle="Gestión de Autores" breadcrumb="Autores">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h5 class="mb-1">Autores</h5>
      <p class="text-muted mb-0" style="font-size:13px;">Administra los autores del catálogo</p>
    </div>
    <button class="btn btn-primary" id="btn-nuevo-autor">
      <i class="bi bi-person-plus me-2"></i>Nuevo Autor
    </button>
  </div>

  <div class="card">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0" id="tabla-autores">
          <thead>
            <tr>
              <th>#</th>
              <th>Nombre</th>
              <th>Nacionalidad</th>
              <th>Materiales</th>
              <th class="text-center">Acciones</th>
            </tr>
          </thead>
          <tbody id="tbody-autores">
            <tr><td colspan="5" class="text-center py-5"><div class="spinner-border text-primary spinner-border-sm"></div></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</DashboardLayout>

<!-- Modal Autor -->
<div class="modal fade" id="modalAutor" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-semibold" id="modal-title-autor">
          <i class="bi bi-person-badge me-2"></i>Nuevo Autor
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="form-autor" novalidate>
          <input type="hidden" id="autor-id" />
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Nombre <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="autor-nombre" required />
            </div>
            <div class="col-md-6">
              <label class="form-label">Apellido <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="autor-apellido" required />
            </div>
            <div class="col-12">
              <label class="form-label">Nacionalidad</label>
              <input type="text" class="form-control" id="autor-nacionalidad" placeholder="Ej: Colombiana" />
            </div>
            <div class="col-12">
              <label class="form-label">Biografía</label>
              <textarea class="form-control" id="autor-bio" rows="3" placeholder="Breve reseña del autor..."></textarea>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-primary" id="btn-guardar-autor">
          <i class="bi bi-check-circle me-2"></i>Guardar
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
const API = 'http://localhost:4000/api';
let editingAutorId = null;
let modalAutor;

function headersAutor() {
  return { 'Content-Type': 'application/json', Authorization: `Bearer ${localStorage.getItem('accessToken')}` };
}

async function cargarAutores() {
  try {
    const res = await fetch(`${API}/autores`, { headers: headersAutor() });
    const data = await res.json();
    const tbody = document.getElementById('tbody-autores');

    if (!data.success || !data.data.length) {
      tbody.innerHTML = '<tr><td colspan="5" class="text-center py-5 text-muted">No hay autores registrados</td></tr>';
      return;
    }

    tbody.innerHTML = data.data.map((a, i) => `
      <tr>
        <td class="text-muted-sm">${i + 1}</td>
        <td>
          <div class="fw-semibold">${a.apellido}, ${a.nombre}</div>
        </td>
        <td>${a.nacionalidad || '—'}</td>
        <td>
          <span class="badge bg-primary bg-opacity-10 text-primary fw-semibold">${a._count?.materiales ?? 0} materiales</span>
        </td>
        <td>
          <div class="d-flex gap-1 justify-content-center">
            <button class="btn btn-icon btn-sm btn-outline-primary" onclick="editarAutor(${a.id})" title="Editar">
              <i class="bi bi-pencil"></i>
            </button>
            <button class="btn btn-icon btn-sm btn-outline-danger" onclick="eliminarAutor(${a.id}, '${a.apellido}, ${a.nombre}')" title="Eliminar">
              <i class="bi bi-trash"></i>
            </button>
          </div>
        </td>
      </tr>
    `).join('');

  } catch (err) {
    console.error(err);
  }
}

async function editarAutor(id) {
  showLoader();
  const res = await fetch(`${API}/autores/${id}`, { headers: headersAutor() });
  const data = await res.json();
  hideLoader();

  if (!data.success) return Swal.fire({ icon: 'error', title: 'Error', text: data.message });

  const a = data.data;
  editingAutorId = id;
  document.getElementById('autor-id').value = a.id;
  document.getElementById('autor-nombre').value = a.nombre;
  document.getElementById('autor-apellido').value = a.apellido;
  document.getElementById('autor-nacionalidad').value = a.nacionalidad || '';
  document.getElementById('autor-bio').value = a.biografia || '';
  document.getElementById('modal-title-autor').innerHTML = '<i class="bi bi-pencil me-2"></i>Editar Autor';
  modalAutor.show();
}

async function eliminarAutor(id, nombre) {
  const result = await Swal.fire({
    title: '¿Eliminar autor?',
    html: `Se eliminará a <strong>${nombre}</strong>.`,
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#c02d2d',
    confirmButtonText: 'Sí, eliminar',
    cancelButtonText: 'Cancelar',
  });
  if (!result.isConfirmed) return;

  showLoader();
  const res = await fetch(`${API}/autores/${id}`, { method: 'DELETE', headers: headersAutor() });
  const data = await res.json();
  hideLoader();

  if (!data.success) return Swal.fire({ icon: 'error', title: 'No se puede eliminar', text: data.message });
  Swal.fire({ icon: 'success', title: 'Autor eliminado', timer: 1500, showConfirmButton: false });
  cargarAutores();
}

document.addEventListener('DOMContentLoaded', function () {
  modalAutor = new bootstrap.Modal(document.getElementById('modalAutor'));
  cargarAutores();

  document.getElementById('btn-nuevo-autor')?.addEventListener('click', function () {
    editingAutorId = null;
    document.getElementById('form-autor').reset();
    document.getElementById('autor-id').value = '';
    document.getElementById('modal-title-autor').innerHTML = '<i class="bi bi-person-badge me-2"></i>Nuevo Autor';
    modalAutor.show();
  });

  document.getElementById('btn-guardar-autor')?.addEventListener('click', async function () {
    const body = {
      nombre: document.getElementById('autor-nombre').value.trim(),
      apellido: document.getElementById('autor-apellido').value.trim(),
      nacionalidad: document.getElementById('autor-nacionalidad').value.trim() || null,
      biografia: document.getElementById('autor-bio').value.trim() || null,
    };

    if (!body.nombre || !body.apellido) {
      return Swal.fire({ icon: 'warning', title: 'Campos requeridos', text: 'Nombre y apellido son obligatorios.' });
    }

    showLoader();
    const isEdit = !!editingAutorId;
    const url = isEdit ? `${API}/autores/${editingAutorId}` : `${API}/autores`;
    const method = isEdit ? 'PUT' : 'POST';

    const res = await fetch(url, { method, headers: headersAutor(), body: JSON.stringify(body) });
    const data = await res.json();
    hideLoader();

    if (!data.success) return Swal.fire({ icon: 'error', title: 'Error', text: data.message });
    modalAutor.hide();
    Swal.fire({ icon: 'success', title: isEdit ? 'Autor actualizado' : 'Autor registrado', timer: 1500, showConfirmButton: false });
    cargarAutores();
  });
});

window.editarAutor = editarAutor;
window.eliminarAutor = eliminarAutor;
</script>