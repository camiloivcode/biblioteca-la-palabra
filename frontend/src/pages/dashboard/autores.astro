---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---
<DashboardLayout pageTitle="Módulo de Autores">
  <!-- Stats Overview -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter mb-lg">
    <div class="bg-white p-6 rounded-xl border border-outline-variant shadow-sm">
      <div class="flex items-center justify-between mb-3">
        <h3 class="font-label-md text-label-md uppercase text-secondary tracking-wider">Total Autores</h3>
        <span class="material-symbols-outlined text-primary">groups</span>
      </div>
      <p class="font-display text-[32px] text-on-surface font-bold" id="stat-autores-total">—</p>
    </div>
    <div class="bg-white p-6 rounded-xl border border-outline-variant shadow-sm">
      <div class="flex items-center justify-between mb-3">
        <h3 class="font-label-md text-label-md uppercase text-secondary tracking-wider">Con Materiales</h3>
        <span class="material-symbols-outlined text-tertiary-container">library_books</span>
      </div>
      <p class="font-display text-[32px] text-on-surface font-bold" id="stat-autores-con">—</p>
    </div>
    <div class="bg-white p-6 rounded-xl border border-outline-variant shadow-sm">
      <div class="flex items-center justify-between mb-3">
        <h3 class="font-label-md text-label-md uppercase text-secondary tracking-wider">Sin Materiales</h3>
        <span class="material-symbols-outlined text-secondary">person_off</span>
      </div>
      <p class="font-display text-[32px] text-on-surface font-bold" id="stat-autores-sin">—</p>
    </div>
  </div>

  <!-- Bento Filters + Featured Author -->
  <div class="grid grid-cols-1 lg:grid-cols-4 gap-gutter mb-lg">
    <div class="lg:col-span-3 bg-white p-lg rounded-xl border border-outline-variant shadow-sm">
      <div class="flex flex-wrap gap-2 mb-lg" id="alpha-filters">
        <button class="px-4 py-1.5 border border-outline-variant rounded-lg font-label-md text-label-md hover:bg-primary-fixed hover:text-primary hover:border-primary transition-colors alpha-filter active" data-letter="">Todos</button>
        <button class="px-4 py-1.5 border border-outline-variant rounded-lg font-label-md text-label-md hover:bg-primary-fixed hover:text-primary hover:border-primary transition-colors alpha-filter" data-letter="A-E">A–E</button>
        <button class="px-4 py-1.5 border border-outline-variant rounded-lg font-label-md text-label-md hover:bg-primary-fixed hover:text-primary hover:border-primary transition-colors alpha-filter" data-letter="F-J">F–J</button>
        <button class="px-4 py-1.5 border border-outline-variant rounded-lg font-label-md text-label-md hover:bg-primary-fixed hover:text-primary hover:border-primary transition-colors alpha-filter" data-letter="K-O">K–O</button>
        <button class="px-4 py-1.5 border border-outline-variant rounded-lg font-label-md text-label-md hover:bg-primary-fixed hover:text-primary hover:border-primary transition-colors alpha-filter" data-letter="P-T">P–T</button>
        <button class="px-4 py-1.5 border border-outline-variant rounded-lg font-label-md text-label-md hover:bg-primary-fixed hover:text-primary hover:border-primary transition-colors alpha-filter" data-letter="U-Z">U–Z</button>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <select id="filtro-nac-autor" class="bg-surface-container-low border border-outline-variant rounded-lg text-label-md px-sm py-1.5 focus:ring-primary focus:border-primary outline-none">
          <option value="">Todas las nacionalidades</option>
        </select>
        <button id="btn-filtrar-autor" class="flex items-center gap-2 px-4 py-1.5 border border-outline-variant rounded-lg font-label-md text-label-md hover:bg-surface-container-low transition-colors">
          <span class="material-symbols-outlined text-[18px]">filter_list</span> Filtrar
        </button>
        <div class="flex-1 hidden lg:block"></div>
        <button id="btn-nuevo-autor" class="flex items-center gap-2 px-4 py-1.5 bg-primary text-on-primary rounded-lg font-label-md text-label-md shadow-sm hover:shadow transition-all active:scale-95">
          <span class="material-symbols-outlined text-[18px]">add</span> Nuevo Autor
        </button>
      </div>
    </div>
    <div class="bg-gradient-to-br from-surface-container-lowest to-primary-fixed/20 p-lg rounded-xl border border-primary/20 shadow-sm flex flex-col items-center text-center">
      <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mb-3">
        <span class="material-symbols-outlined text-[32px] text-primary">auto_stories</span>
      </div>
      <h4 class="font-headline-sm text-headline-sm text-on-surface">Jorge Luis Borges</h4>
      <p class="font-body-md text-body-md text-on-surface-variant mb-2">Argentina · 1899–1986</p>
      <p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-3">Escritor, poeta y ensayista argentino, figura clave de la literatura universal. Autor de "Ficciones", "El Aleph" y "El jardín de los senderos que se bifurcan".</p>
      <span class="mt-3 text-label-sm font-bold text-primary bg-primary-fixed px-3 py-1 rounded-full">Autor Destacado</span>
    </div>
  </div>

  <!-- Table -->
  <section class="bg-white rounded-xl border border-outline-variant shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead class="bg-surface-container-low">
          <tr>
            <th class="px-6 py-4 font-label-md text-label-md text-secondary uppercase">#</th>
            <th class="px-6 py-4 font-label-md text-label-md text-secondary uppercase">Nombre</th>
            <th class="px-6 py-4 font-label-md text-label-md text-secondary uppercase">Nacionalidad</th>
            <th class="px-6 py-4 font-label-md text-label-md text-secondary uppercase text-center">Materiales</th>
            <th class="px-6 py-4 font-label-md text-label-md text-secondary uppercase text-right">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-outline-variant" id="tbody-autores">
          <tr>
            <td colspan="5" class="px-6 py-8 text-center font-body-md text-outline">
              <span class="material-symbols-outlined animate-spin inline-block">sync</span> Cargando autores...
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Modal Autor -->
  <div class="modal-backdrop modal-hidden" id="modalAutorBackdrop">
    <div class="bg-surface-container-lowest w-full max-w-lg rounded-xl shadow-2xl overflow-hidden border border-outline-variant">
      <div class="px-xl py-lg bg-primary-container text-on-primary flex justify-between items-center">
        <div>
          <h2 class="font-headline-md text-headline-md" id="modal-title-autor">Nuevo Autor</h2>
          <p class="font-body-md opacity-90">Completa los datos del autor</p>
        </div>
        <button class="material-symbols-outlined hover:bg-white/10 p-2 rounded-full transition-colors border-0 bg-transparent text-on-primary cursor-pointer modal-close-autor">close</button>
      </div>
      <form id="form-autor" class="p-xl space-y-lg">
        <input type="hidden" id="autor-id" />
        <div class="grid grid-cols-2 gap-md">
          <div>
            <label class="block font-label-md text-label-md text-on-surface-variant mb-xs">Nombre <span class="text-error">*</span></label>
            <input type="text" id="autor-nombre" class="w-full p-md border border-outline-variant rounded-lg bg-white focus:ring-2 focus:ring-primary focus:border-primary transition-all font-body-md outline-none" required />
          </div>
          <div>
            <label class="block font-label-md text-label-md text-on-surface-variant mb-xs">Apellido <span class="text-error">*</span></label>
            <input type="text" id="autor-apellido" class="w-full p-md border border-outline-variant rounded-lg bg-white focus:ring-2 focus:ring-primary focus:border-primary transition-all font-body-md outline-none" required />
          </div>
        </div>
        <div>
          <label class="block font-label-md text-label-md text-on-surface-variant mb-xs">Nacionalidad</label>
          <input type="text" id="autor-nacionalidad" class="w-full p-md border border-outline-variant rounded-lg bg-white focus:ring-2 focus:ring-primary focus:border-primary transition-all font-body-md outline-none" placeholder="Ej: Colombiana" />
        </div>
        <div>
          <label class="block font-label-md text-label-md text-on-surface-variant mb-xs">Biografía</label>
          <textarea id="autor-bio" class="w-full p-md border border-outline-variant rounded-lg bg-white focus:ring-2 focus:ring-primary focus:border-primary transition-all font-body-md outline-none resize-none" placeholder="Breve reseña del autor..." rows="3"></textarea>
        </div>
        <div class="flex justify-end gap-md pt-lg border-t border-outline-variant">
          <button type="button" class="px-lg py-sm border border-secondary text-secondary rounded-lg font-title-lg hover:bg-secondary-container/10 transition-all modal-close-autor">Cancelar</button>
          <button type="submit" class="px-2xl py-sm bg-primary text-on-primary rounded-lg font-title-lg hover:shadow-lg active:scale-95 transition-all shadow-md">Guardar</button>
        </div>
      </form>
    </div>
  </div>
</DashboardLayout>

<script src="../../scripts/autores.js"></script>
