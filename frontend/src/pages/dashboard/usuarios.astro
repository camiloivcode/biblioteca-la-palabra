---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---
<DashboardLayout pageTitle="Gestión de Usuarios">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-lg">
    <div>
      <p class="text-on-surface-variant font-body-md text-body-md">Solo administradores pueden gestionar usuarios</p>
    </div>
    <button id="btn-nuevo-user" class="flex items-center gap-2 px-4 py-1.5 bg-primary text-on-primary rounded-lg font-label-md text-label-md shadow-sm hover:shadow transition-all active:scale-95">
      <span class="material-symbols-outlined text-[18px]">person_add</span> Nuevo Usuario
    </button>
  </div>

  <!-- Table -->
  <section class="bg-white rounded-xl border border-outline-variant shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead class="bg-surface-container-low">
          <tr>
            <th class="px-6 py-4 font-label-md text-label-md text-secondary uppercase">#</th>
            <th class="px-6 py-4 font-label-md text-label-md text-secondary uppercase">Nombre</th>
            <th class="px-6 py-4 font-label-md text-label-md text-secondary uppercase">Email</th>
            <th class="px-6 py-4 font-label-md text-label-md text-secondary uppercase">Rol</th>
            <th class="px-6 py-4 font-label-md text-label-md text-secondary uppercase text-center">Estado</th>
            <th class="px-6 py-4 font-label-md text-label-md text-secondary uppercase text-center">Registrado</th>
            <th class="px-6 py-4 font-label-md text-label-md text-secondary uppercase text-right">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-outline-variant" id="tbody-users">
          <tr>
            <td colspan="7" class="px-6 py-8 text-center font-body-md text-outline">
              <span class="material-symbols-outlined animate-spin inline-block">sync</span> Cargando usuarios...
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Modal Usuario -->
  <div class="modal-backdrop modal-hidden" id="modalUserBackdrop">
    <div class="bg-surface-container-lowest w-full max-w-md rounded-xl shadow-2xl overflow-hidden border border-outline-variant">
      <div class="px-xl py-lg bg-primary-container text-on-primary flex justify-between items-center">
        <div>
          <h2 class="font-headline-md text-headline-md" id="modal-title-user">Nuevo Usuario</h2>
          <p class="font-body-md opacity-90">Crea una cuenta para el personal</p>
        </div>
        <button class="material-symbols-outlined hover:bg-white/10 p-2 rounded-full transition-colors border-0 bg-transparent text-on-primary cursor-pointer modal-close-user">close</button>
      </div>
      <form id="form-user" class="p-xl space-y-lg">
        <input type="hidden" id="user-id" />
        <div>
          <label class="block font-label-md text-label-md text-on-surface-variant mb-xs">Nombre <span class="text-error">*</span></label>
          <input type="text" id="user-nombre" class="w-full p-md border border-outline-variant rounded-lg bg-white focus:ring-2 focus:ring-primary focus:border-primary transition-all font-body-md outline-none" required />
        </div>
        <div>
          <label class="block font-label-md text-label-md text-on-surface-variant mb-xs">Email <span class="text-error">*</span></label>
          <input type="email" id="user-email" class="w-full p-md border border-outline-variant rounded-lg bg-white focus:ring-2 focus:ring-primary focus:border-primary transition-all font-body-md outline-none" required />
        </div>
        <div>
          <label class="block font-label-md text-label-md text-on-surface-variant mb-xs">
            Contraseña <span class="text-error" id="pass-required">*</span>
          </label>
          <input type="password" id="user-password" class="w-full p-md border border-outline-variant rounded-lg bg-white focus:ring-2 focus:ring-primary focus:border-primary transition-all font-body-md outline-none" placeholder="Mín. 8 caracteres, 1 mayúscula, 1 número" />
          <p class="font-label-md text-xs text-on-surface-variant mt-1" id="pass-hint" style="display:none;">Déjala en blanco para no cambiarla</p>
        </div>
        <div>
          <label class="block font-label-md text-label-md text-on-surface-variant mb-xs">Rol <span class="text-error">*</span></label>
          <select id="user-role" class="w-full p-md border border-outline-variant rounded-lg bg-white focus:ring-2 focus:ring-primary focus:border-primary transition-all font-body-md outline-none appearance-none">
            <option value="BIBLIOTECARIO">Bibliotecario</option>
            <option value="ADMIN">Administrador</option>
          </select>
        </div>
        <div class="flex justify-end gap-md pt-lg border-t border-outline-variant">
          <button type="button" class="px-lg py-sm border border-secondary text-secondary rounded-lg font-title-lg hover:bg-secondary-container/10 transition-all modal-close-user">Cancelar</button>
          <button type="submit" class="px-2xl py-sm bg-primary text-on-primary rounded-lg font-title-lg hover:shadow-lg active:scale-95 transition-all shadow-md">Guardar</button>
        </div>
      </form>
    </div>
  </div>
</DashboardLayout>

<script src="../../scripts/usuarios.js"></script>
