---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---
<DashboardLayout pageTitle="Gestión de Usuarios" breadcrumb="Usuarios">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h5 class="mb-1">Usuarios del Sistema</h5>
      <p class="text-muted mb-0" style="font-size:13px;">Solo administradores pueden gestionar usuarios</p>
    </div>
    <button class="btn btn-primary" id="btn-nuevo-user">
      <i class="bi bi-person-plus me-2"></i>Nuevo Usuario
    </button>
  </div>

  <div class="card">
    <div class="card-body p-0">
      <table class="table table-hover mb-0">
        <thead>
          <tr>
            <th>#</th><th>Nombre</th><th>Email</th><th>Rol</th>
            <th>Estado</th><th>Registrado</th><th class="text-center">Acciones</th>
          </tr>
        </thead>
        <tbody id="tbody-users">
          <tr><td colspan="7" class="text-center py-5"><div class="spinner-border text-primary spinner-border-sm"></div></td></tr>
        </tbody>
      </table>
    </div>
  </div>
</DashboardLayout>

<!-- Modal Usuario -->
<div class="modal fade" id="modalUser" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-semibold" id="modal-title-user">Nuevo Usuario</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="user-id" />
        <div class="row g-3">
          <div class="col-12">
            <label class="form-label">Nombre <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="user-nombre" required />
          </div>
          <div class="col-12">
            <label class="form-label">Email <span class="text-danger">*</span></label>
            <input type="email" class="form-control" id="user-email" required />
          </div>
          <div class="col-12">
            <label class="form-label">Contraseña <span class="text-danger" id="pass-required">*</span></label>
            <input type="password" class="form-control" id="user-password" placeholder="Mín. 8 caracteres, 1 mayúscula, 1 número" />
            <div class="form-text" id="pass-hint">Déjala en blanco para no cambiarla</div>
          </div>
          <div class="col-12">
            <label class="form-label">Rol <span class="text-danger">*</span></label>
            <select class="form-select" id="user-role">
              <option value="BIBLIOTECARIO">Bibliotecario</option>
              <option value="ADMIN">Administrador</option>
            </select>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-primary" id="btn-guardar-user">
          <i class="bi bi-check-circle me-2"></i>Guardar
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
const API = 'http://localhost:4000/api';
let editingUserId = null;
let modalUser;

function hUser() {
  return { 'Content-Type': 'application/json', Authorization: `Bearer ${localStorage.getItem('accessToken')}` };
}

async function cargarUsuarios() {
  const res = await fetch(`${API}/users`, { headers: hUser() });
  const data = await res.json();

  if (!data.success) {
    document.getElementById('tbody-users').innerHTML =
      '<tr><td colspan="7" class="text-center py-4 text-danger">No tienes permisos o error al cargar</td></tr>';
    return;
  }

  const tbody = document.getElementById('tbody-users');
  tbody.innerHTML = data.data.map((u, i) => `
    <tr>
      <td class="text-muted-sm">${i + 1}</td>
      <td>
        <div class="d-flex align-items-center gap-2">
          <div class="user-avatar" style="width:30px;height:30px;font-size:11px;background:${u.role === 'ADMIN' ? 'var(--color-accent)' : 'var(--color-primary)'};">
            ${u.nombre.charAt(0)}
          </div>
          <span class="fw-semibold">${u.nombre}</span>
        </div>
      </td>
      <td>${u.email}</td>
      <td>
        <span class="badge ${u.role === 'ADMIN' ? 'bg-warning text-dark' : 'bg-primary bg-opacity-10 text-primary'} fw-semibold">
          ${u.role}
        </span>
      </td>
      <td>
        <span class="status-badge ${u.activo ? 'badge-activo' : 'badge-suspendido'}">
          ${u.activo ? 'Activo' : 'Inactivo'}
        </span>
      </td>
      <td class="text-muted-sm">${new Date(u.createdAt).toLocaleDateString('es-CO')}</td>
      <td>
        <div class="d-flex gap-1 justify-content-center">
          <button class="btn btn-icon btn-sm btn-outline-primary" onclick="editarUser(${u.id})" title="Editar">
            <i class="bi bi-pencil"></i>
          </button>
          <button class="btn btn-icon btn-sm btn-outline-${u.activo ? 'warning' : 'success'}" onclick="toggleUser(${u.id})" title="${u.activo ? 'Desactivar' : 'Activar'}">
            <i class="bi bi-${u.activo ? 'person-dash' : 'person-check'}"></i>
          </button>
        </div>
      </td>
    </tr>
  `).join('');
}

async function editarUser(id) {
  showLoader();
  const res = await fetch(`${API}/users/${id}`, { headers: hUser() });
  const data = await res.json();
  hideLoader();
  if (!data.success) return;

  editingUserId = id;
  const u = data.data;
  document.getElementById('user-id').value = u.id;
  document.getElementById('user-nombre').value = u.nombre;
  document.getElementById('user-email').value = u.email;
  document.getElementById('user-password').value = '';
  document.getElementById('user-role').value = u.role;
  document.getElementById('modal-title-user').textContent = 'Editar Usuario';
  document.getElementById('pass-required').style.display = 'none';
  document.getElementById('pass-hint').style.display = 'block';
  modalUser.show();
}

async function toggleUser(id) {
  showLoader();
  const res = await fetch(`${API}/users/${id}/toggle`, { method: 'PATCH', headers: hUser() });
  const data = await res.json();
  hideLoader();
  if (data.success) {
    Swal.fire({ icon: 'success', title: data.message, timer: 1200, showConfirmButton: false });
    cargarUsuarios();
  }
}

document.addEventListener('DOMContentLoaded', function() {
  // Verificar que sea admin
  const user = JSON.parse(localStorage.getItem('user') || '{}');
  if (user.role !== 'ADMIN') {
    window.location.href = '/dashboard';
    return;
  }

  modalUser = new bootstrap.Modal(document.getElementById('modalUser'));
  cargarUsuarios();

  document.getElementById('btn-nuevo-user')?.addEventListener('click', function() {
    editingUserId = null;
    document.getElementById('user-id').value = '';
    document.getElementById('user-nombre').value = '';
    document.getElementById('user-email').value = '';
    document.getElementById('user-password').value = '';
    document.getElementById('user-role').value = 'BIBLIOTECARIO';
    document.getElementById('modal-title-user').textContent = 'Nuevo Usuario';
    document.getElementById('pass-required').style.display = 'inline';
    document.getElementById('pass-hint').style.display = 'none';
    modalUser.show();
  });

  document.getElementById('btn-guardar-user')?.addEventListener('click', async function() {
    const isEdit = !!editingUserId;
    const body = {
      nombre: document.getElementById('user-nombre').value.trim(),
      email: document.getElementById('user-email').value.trim(),
      role: document.getElementById('user-role').value,
    };
    const password = document.getElementById('user-password').value;
    if (password) body.password = password;

    if (!body.nombre || !body.email) {
      return Swal.fire({ icon: 'warning', title: 'Campos requeridos', text: 'Nombre y email son obligatorios.' });
    }
    if (!isEdit && !password) {
      return Swal.fire({ icon: 'warning', title: 'Contraseña requerida', text: 'Ingresa una contraseña para el nuevo usuario.' });
    }

    showLoader();
    const url = isEdit ? `${API}/users/${editingUserId}` : `${API}/users`;
    const res = await fetch(url, { method: isEdit ? 'PUT' : 'POST', headers: hUser(), body: JSON.stringify(body) });
    const data = await res.json();
    hideLoader();

    if (!data.success) return Swal.fire({ icon: 'error', title: 'Error', text: data.message });
    modalUser.hide();
    Swal.fire({ icon: 'success', title: isEdit ? 'Usuario actualizado' : 'Usuario creado', timer: 1500, showConfirmButton: false });
    cargarUsuarios();
  });
});

window.editarUser = editarUser;
window.toggleUser = toggleUser;
</script>