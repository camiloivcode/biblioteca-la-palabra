---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---
<DashboardLayout pageTitle="Materiales">
  <div class="max-w-max-width mx-auto">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 mb-xl">
      <div>
        <h2 class="font-headline-lg text-headline-lg text-on-surface">Gestión de Materiales</h2>
        <p class="text-on-surface-variant mt-1">Administra el catálogo de libros, revistas y otros recursos de la biblioteca.</p>
      </div>
      <button id="btn-nuevo-material" class="flex items-center gap-2 bg-primary text-on-primary px-6 py-3 rounded-lg font-title-lg text-title-lg shadow-md hover:bg-primary-container transition-all active:scale-95">
        <span class="material-symbols-outlined">add</span>
        Nuevo Material
      </button>
    </div>

    <!-- Stats Summary -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-gutter mb-xl" id="stats-materiales">
      <div class="bg-surface border border-outline-variant rounded-xl p-md shadow-sm">
        <div class="flex items-center gap-md">
          <div class="bg-primary-fixed p-3 rounded-lg"><span class="material-symbols-outlined text-primary">auto_stories</span></div>
          <div><p class="text-label-sm text-on-surface-variant uppercase">Total Libros</p><p class="font-headline-sm text-headline-sm" id="stat-total">—</p></div>
        </div>
      </div>
      <div class="bg-surface border border-outline-variant rounded-xl p-md shadow-sm">
        <div class="flex items-center gap-md">
          <div class="bg-tertiary-fixed-dim p-3 rounded-lg text-on-tertiary-fixed-variant"><span class="material-symbols-outlined">check_circle</span></div>
          <div><p class="text-label-sm text-on-surface-variant uppercase">Disponibles</p><p class="font-headline-sm text-headline-sm" id="stat-disponibles">—</p></div>
        </div>
      </div>
      <div class="bg-secondary-fixed rounded-xl p-md shadow-sm">
        <div class="flex items-center gap-md">
          <div class="bg-secondary-container p-3 rounded-lg text-on-secondary-container"><span class="material-symbols-outlined">sync_alt</span></div>
          <div><p class="text-label-sm text-on-surface-variant uppercase">Prestados</p><p class="font-headline-sm text-headline-sm" id="stat-prestados">—</p></div>
        </div>
      </div>
      <div class="bg-surface border border-outline-variant rounded-xl p-md shadow-sm">
        <div class="flex items-center gap-md">
          <div class="bg-error-container p-3 rounded-lg text-on-error-container"><span class="material-symbols-outlined">warning</span></div>
          <div><p class="text-label-sm text-on-surface-variant uppercase">En Mora</p><p class="font-headline-sm text-headline-sm" id="stat-mora">—</p></div>
        </div>
      </div>
    </div>

    <!-- Table Section -->
    <div class="bg-surface border border-outline-variant rounded-xl shadow-sm">
      <div class="p-md border-b border-outline-variant flex flex-col md:flex-row items-start md:items-center justify-between gap-3">
        <div class="flex flex-wrap gap-md">
          <select id="filtro-categoria-mat" class="bg-surface-container-low border-outline-variant rounded-lg text-label-md px-sm py-1 focus:ring-primary focus:border-primary">
            <option value="">Todas las Categorías</option>
          </select>
          <select id="filtro-tipo-mat" class="bg-surface-container-low border-outline-variant rounded-lg text-label-md px-sm py-1 focus:ring-primary focus:border-primary">
            <option value="">Tipo: Todos</option>
            <option value="LIBRO">Libro</option>
            <option value="REVISTA">Revista</option>
            <option value="DVD">DVD</option>
            <option value="PERIODICO">Periódico</option>
            <option value="OTRO">Otro</option>
          </select>
          <select id="filtro-estado-mat" class="bg-surface-container-low border-outline-variant rounded-lg text-label-md px-sm py-1 focus:ring-primary focus:border-primary">
            <option value="">Estado: Todos</option>
            <option value="DISPONIBLE">Disponible</option>
            <option value="PRESTADO">Prestado</option>
          </select>
        </div>
        <div class="flex gap-2 items-center">
          <button id="btn-filtrar-mat" class="bg-surface-container-low px-3 py-1 rounded-lg text-label-md hover:bg-surface-container-high transition-colors">Filtrar</button>
          <p class="text-label-md text-on-surface-variant" id="pag-mat-info"></p>
        </div>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse min-w-[600px]">
          <thead class="bg-surface-container-low text-on-surface-variant">
            <tr>
              <th class="text-left py-4 px-md font-label-md text-label-md uppercase tracking-wider">Código (ID)</th>
              <th class="text-left py-4 px-md font-label-md text-label-md uppercase tracking-wider">Título</th>
              <th class="text-left py-4 px-md font-label-md text-label-md uppercase tracking-wider">Categoría</th>
              <th class="text-left py-4 px-md font-label-md text-label-md uppercase tracking-wider">Estado</th>
              <th class="text-right py-4 px-md font-label-md text-label-md uppercase tracking-wider">Acciones</th>
            </tr>
          </thead>
          <tbody id="tbody-materiales">
            <tr class="border-b border-outline-variant">
              <td class="p-md"><div class="h-4 w-16 skeleton rounded"></div></td>
              <td class="p-md"><div class="h-4 w-48 skeleton rounded"></div></td>
              <td class="p-md"><div class="h-6 w-24 skeleton rounded-full"></div></td>
              <td class="p-md"><div class="h-6 w-20 skeleton rounded-full"></div></td>
              <td class="p-md"><div class="flex justify-end gap-md"><div class="h-8 w-8 skeleton rounded"></div><div class="h-8 w-8 skeleton rounded"></div></div></td>
            </tr>
            <tr class="border-b border-outline-variant">
              <td class="p-md"><div class="h-4 w-16 skeleton rounded"></div></td>
              <td class="p-md"><div class="h-4 w-56 skeleton rounded"></div></td>
              <td class="p-md"><div class="h-6 w-24 skeleton rounded-full"></div></td>
              <td class="p-md"><div class="h-6 w-20 skeleton rounded-full"></div></td>
              <td class="p-md"><div class="flex justify-end gap-md"><div class="h-8 w-8 skeleton rounded"></div><div class="h-8 w-8 skeleton rounded"></div></div></td>
            </tr>
            <tr class="border-b border-outline-variant">
              <td class="p-md"><div class="h-4 w-16 skeleton rounded"></div></td>
              <td class="p-md"><div class="h-4 w-40 skeleton rounded"></div></td>
              <td class="p-md"><div class="h-6 w-24 skeleton rounded-full"></div></td>
              <td class="p-md"><div class="h-6 w-20 skeleton rounded-full"></div></td>
              <td class="p-md"><div class="flex justify-end gap-md"><div class="h-8 w-8 skeleton rounded"></div><div class="h-8 w-8 skeleton rounded"></div></div></td>
            </tr>
          </tbody>
        </table>
      </div>
      <!-- Pagination -->
      <div class="p-md flex items-center justify-between border-t border-outline-variant bg-surface-container-low" id="pag-materiales">
        <button id="pag-prev" class="flex items-center gap-1 text-on-surface-variant hover:text-primary transition-colors disabled:opacity-50 border-0 bg-transparent cursor-pointer">
          <span class="material-symbols-outlined">chevron_left</span> Anterior
        </button>
        <div class="flex gap-2" id="pag-mat-btns"></div>
        <button id="pag-next" class="flex items-center gap-1 text-on-surface-variant hover:text-primary transition-colors border-0 bg-transparent cursor-pointer">
          Siguiente <span class="material-symbols-outlined">chevron_right</span>
        </button>
      </div>
    </div>

    <!-- Info Tip -->
    <div class="mt-xl bg-primary-fixed-dim bg-opacity-20 border border-primary-container p-lg rounded-xl flex gap-md items-start">
      <span class="material-symbols-outlined text-primary text-3xl">info</span>
      <div>
        <h4 class="font-headline-sm text-headline-sm text-on-primary-fixed-variant">Tip de Administración</h4>
        <p class="text-body-md text-on-primary-fixed-variant mt-1">Recuerda que los materiales marcados como 'Préstamo Restringido' solo pueden ser consultados dentro de la sala de lectura y no permiten retiro a domicilio.</p>
      </div>
    </div>
  </div>

  <!-- Modal Material -->
  <div class="modal-backdrop modal-hidden" id="modalMaterialBackdrop">
    <div class="bg-surface-container-lowest w-full max-w-2xl rounded-xl shadow-2xl overflow-hidden border border-outline-variant">
      <div class="px-xl py-lg bg-primary-container text-on-primary flex justify-between items-center">
        <div>
          <h2 class="font-headline-md text-headline-md" id="modal-title-material">Registrar Nuevo Material</h2>
          <p class="font-body-md opacity-90">Ingrese los detalles para el catálogo institucional</p>
        </div>
        <button class="material-symbols-outlined hover:bg-white/10 p-2 rounded-full transition-colors border-0 bg-transparent text-on-primary cursor-pointer modal-close-material">close</button>
      </div>
      <form id="form-material" class="p-xl space-y-lg">
        <input type="hidden" id="material-id" />
        <div class="grid grid-cols-2 gap-lg">
          <div class="col-span-2">
            <label class="block font-label-md text-label-md text-on-surface-variant mb-xs">Título del Material <span class="text-error">*</span></label>
            <input type="text" id="mat-titulo" class="w-full p-md border border-outline-variant rounded-lg bg-white focus:ring-2 focus:ring-primary focus:border-primary transition-all font-body-md outline-none" placeholder="Ej: El Aleph" required />
          </div>
          <div>
            <label class="block font-label-md text-label-md text-on-surface-variant mb-xs">ISBN / Código Interno</label>
            <input type="text" id="mat-isbn" class="w-full p-md border border-outline-variant rounded-lg bg-white focus:ring-2 focus:ring-primary focus:border-primary transition-all font-body-md outline-none" placeholder="978-XXXX-XXXX" />
          </div>
          <div>
            <label class="block font-label-md text-label-md text-on-surface-variant mb-xs">Tipo <span class="text-error">*</span></label>
            <select id="mat-tipo" class="w-full p-md border border-outline-variant rounded-lg bg-white focus:ring-2 focus:ring-primary focus:border-primary transition-all font-body-md outline-none appearance-none">
              <option value="LIBRO">Libro</option>
              <option value="REVISTA">Revista</option>
              <option value="DVD">DVD</option>
              <option value="PERIODICO">Periódico</option>
              <option value="OTRO">Otro</option>
            </select>
          </div>
          <div>
            <label class="block font-label-md text-label-md text-on-surface-variant mb-xs">Año Publicación</label>
            <input type="number" id="mat-anio" class="w-full p-md border border-outline-variant rounded-lg bg-white focus:ring-2 focus:ring-primary focus:border-primary transition-all font-body-md outline-none" placeholder="2024" />
          </div>
          <div>
            <label class="block font-label-md text-label-md text-on-surface-variant mb-xs">Autor <span class="text-error">*</span></label>
            <select id="mat-autor" class="w-full p-md border border-outline-variant rounded-lg bg-white focus:ring-2 focus:ring-primary focus:border-primary transition-all font-body-md outline-none appearance-none">
              <option value="">Seleccionar autor...</option>
            </select>
          </div>
          <div>
            <label class="block font-label-md text-label-md text-on-surface-variant mb-xs">Categoría <span class="text-error">*</span></label>
            <select id="mat-categoria" class="w-full p-md border border-outline-variant rounded-lg bg-white focus:ring-2 focus:ring-primary focus:border-primary transition-all font-body-md outline-none appearance-none">
              <option value="">Seleccionar...</option>
            </select>
          </div>
          <div class="col-span-2">
            <label class="block font-label-md text-label-md text-on-surface-variant mb-sm">Tipo de Material</label>
            <div class="flex gap-md">
              <label class="flex-1 flex items-center justify-center gap-2 p-md border border-outline-variant rounded-lg cursor-pointer hover:bg-secondary-container/10 transition-colors has-[:checked]:bg-primary-container has-[:checked]:text-on-primary has-[:checked]:border-primary">
                <input checked class="hidden" name="material_radio_type" type="radio" value="LIBRO" />
                <span class="material-symbols-outlined">menu_book</span>
                <span class="font-label-md">Libro</span>
              </label>
              <label class="flex-1 flex items-center justify-center gap-2 p-md border border-outline-variant rounded-lg cursor-pointer hover:bg-secondary-container/10 transition-colors has-[:checked]:bg-primary-container has-[:checked]:text-on-primary has-[:checked]:border-primary">
                <input class="hidden" name="material_radio_type" type="radio" value="REVISTA" />
                <span class="material-symbols-outlined">auto_stories</span>
                <span class="font-label-md">Revista</span>
              </label>
              <label class="flex-1 flex items-center justify-center gap-2 p-md border border-outline-variant rounded-lg cursor-pointer hover:bg-secondary-container/10 transition-colors has-[:checked]:bg-primary-container has-[:checked]:text-on-primary has-[:checked]:border-primary">
                <input class="hidden" name="material_radio_type" type="radio" value="DVD" />
                <span class="material-symbols-outlined">movie</span>
                <span class="font-label-md">DVD</span>
              </label>
            </div>
          </div>
          <div class="col-span-2">
            <label class="block font-label-md text-label-md text-on-surface-variant mb-xs">Descripción / Notas</label>
            <textarea id="mat-desc" class="w-full p-md border border-outline-variant rounded-lg bg-white focus:ring-2 focus:ring-primary focus:border-primary transition-all font-body-md outline-none resize-none" placeholder="Resumen del contenido, estado del material o ubicación física..." rows="3"></textarea>
          </div>
          <div class="col-span-2">
            <label class="block font-label-md text-label-md text-on-surface-variant mb-xs">Stock</label>
            <input type="number" id="mat-stock" class="w-full p-md border border-outline-variant rounded-lg bg-white focus:ring-2 focus:ring-primary focus:border-primary transition-all font-body-md outline-none" value="1" min="1" />
          </div>
        </div>
        <div class="flex justify-end gap-md pt-lg border-t border-outline-variant">
          <button type="button" class="px-lg py-sm border border-secondary text-secondary rounded-lg font-title-lg hover:bg-secondary-container/10 transition-all modal-close-material">Cancelar</button>
          <button type="submit" class="px-2xl py-sm bg-primary text-on-primary rounded-lg font-title-lg hover:shadow-lg hover:opacity-90 active:scale-95 transition-all shadow-md">Guardar Material</button>
        </div>
      </form>
    </div>
  </div>
</DashboardLayout>

<script src="../../scripts/materiales.js"></script>
