---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---
<DashboardLayout pageTitle="Reportes" breadcrumb="Reportes">

  <div class="row g-3 mb-4">
    <div class="col-12">
      <h5 class="mb-1">Centro de Reportes</h5>
      <p class="text-muted mb-0" style="font-size:13px;">Análisis y estadísticas del sistema</p>
    </div>
  </div>

  <!-- Pestañas -->
  <ul class="nav nav-tabs mb-4" id="reportes-tabs">
    <li class="nav-item">
      <button class="nav-link active" data-tab="historial">
        <i class="bi bi-clock-history me-1"></i>Historial de Préstamos
      </button>
    </li>
    <li class="nav-item">
      <button class="nav-link" data-tab="morosos">
        <i class="bi bi-exclamation-triangle me-1"></i>Socios Morosos
      </button>
    </li>
    <li class="nav-item">
      <button class="nav-link" data-tab="populares">
        <i class="bi bi-star me-1"></i>Materiales Populares
      </button>
    </li>
  </ul>

  <!-- Panel: Historial -->
  <div id="tab-historial">
    <div class="card mb-3">
      <div class="card-body py-3">
        <div class="row g-3 align-items-end">
          <div class="col-md-3">
            <label class="form-label">Desde</label>
            <input type="date" class="form-control" id="rep-desde" />
          </div>
          <div class="col-md-3">
            <label class="form-label">Hasta</label>
            <input type="date" class="form-control" id="rep-hasta" />
          </div>
          <div class="col-md-3">
            <label class="form-label">Estado</label>
            <select class="form-select" id="rep-estado">
              <option value="">Todos</option>
              <option value="ACTIVO">Activo</option>
              <option value="MORA">Mora</option>
              <option value="DEVUELTO">Devuelto</option>
            </select>
          </div>
          <div class="col-md-3">
            <button class="btn btn-primary w-100" id="btn-generar-historial">
              <i class="bi bi-search me-1"></i>Generar
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0" id="tabla-historial">
            <thead>
              <tr>
                <th>Fecha</th><th>Socio</th><th>Material</th>
                <th>Vencimiento</th><th>Dev. Real</th><th>Estado</th>
              </tr>
            </thead>
            <tbody id="tbody-historial">
              <tr><td colspan="6" class="text-center py-4 text-muted">Selecciona filtros y presiona Generar</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Panel: Morosos -->
  <div id="tab-morosos" style="display:none;">
    <div class="card">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0" id="tabla-morosos">
            <thead>
              <tr><th>#</th><th>Socio</th><th>DNI</th><th>Préstamos en Mora</th></tr>
            </thead>
            <tbody id="tbody-morosos">
              <tr><td colspan="4" class="text-center py-5"><div class="spinner-border text-primary spinner-border-sm"></div></td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Panel: Populares -->
  <div id="tab-populares" style="display:none;">
    <div class="card">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead>
              <tr><th>Posición</th><th>Material</th><th>Tipo</th><th>Total Préstamos</th></tr>
            </thead>
            <tbody id="tbody-populares">
              <tr><td colspan="4" class="text-center py-5"><div class="spinner-border text-primary spinner-border-sm"></div></td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

</DashboardLayout>

<script is:inline>
const API = 'http://localhost:4000/api';
function hRep() {
  return { 'Content-Type': 'application/json', Authorization: `Bearer ${localStorage.getItem('accessToken')}` };
}

function estadoBadge(e) {
  const m = { ACTIVO: 'badge-activo', MORA: 'badge-mora', DEVUELTO: 'badge-devuelto' };
  return `<span class="status-badge ${m[e] || ''}">${e}</span>`;
}

// Tabs
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('[data-tab]').forEach(btn => {
    btn.addEventListener('click', function() {
      document.querySelectorAll('[data-tab]').forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      const tab = this.dataset.tab;
      document.getElementById('tab-historial').style.display = tab === 'historial' ? '' : 'none';
      document.getElementById('tab-morosos').style.display = tab === 'morosos' ? '' : 'none';
      document.getElementById('tab-populares').style.display = tab === 'populares' ? '' : 'none';

      if (tab === 'morosos') cargarMorosos();
      if (tab === 'populares') cargarPopulares();
    });
  });

  // Generar historial
  document.getElementById('btn-generar-historial')?.addEventListener('click', async function() {
    const params = new URLSearchParams();
    const desde = document.getElementById('rep-desde').value;
    const hasta = document.getElementById('rep-hasta').value;
    const estado = document.getElementById('rep-estado').value;
    if (desde) params.append('desde', desde);
    if (hasta) params.append('hasta', hasta);
    if (estado) params.append('estado', estado);

    showLoader();
    const res = await fetch(`${API}/reportes/historial?${params}`, { headers: hRep() });
    const data = await res.json();
    hideLoader();

    const tbody = document.getElementById('tbody-historial');
    if (!data.success || !data.data.length) {
      tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-muted">Sin resultados</td></tr>';
      return;
    }

    tbody.innerHTML = data.data.map(p => `
      <tr>
        <td>${new Date(p.fechaPrestamo).toLocaleDateString('es-CO')}</td>
        <td><div class="fw-semibold">${p.socio.apellido}, ${p.socio.nombre}</div><div class="text-muted-sm">DNI: ${p.socio.dni}</div></td>
        <td>${p.material.titulo}</td>
        <td>${new Date(p.fechaDevolucion).toLocaleDateString('es-CO')}</td>
        <td>${p.fechaDevReal ? new Date(p.fechaDevReal).toLocaleDateString('es-CO') : '—'}</td>
        <td>${estadoBadge(p.estado)}</td>
      </tr>
    `).join('');
  });
});

async function cargarMorosos() {
  const res = await fetch(`${API}/reportes/socios-morosos`, { headers: hRep() });
  const data = await res.json();
  const tbody = document.getElementById('tbody-morosos');

  if (!data.success || !data.data.length) {
    tbody.innerHTML = '<tr><td colspan="4" class="text-center py-4" style="color:var(--color-success);">✓ No hay socios en mora</td></tr>';
    return;
  }

  tbody.innerHTML = data.data.map((s, i) => `
    <tr>
      <td>${i + 1}</td>
      <td class="fw-semibold">${s.apellido}, ${s.nombre}</td>
      <td>${s.dni}</td>
      <td>
        ${s.prestamos.map(p => `<div class="text-muted-sm">• ${p.material.titulo}</div>`).join('')}
        <span class="badge bg-danger bg-opacity-10 text-danger fw-semibold">${s.prestamos.length} en mora</span>
      </td>
    </tr>
  `).join('');
}

async function cargarPopulares() {
  const res = await fetch(`${API}/reportes/materiales-populares`, { headers: hRep() });
  const data = await res.json();
  const tbody = document.getElementById('tbody-populares');

  if (!data.success || !data.data.length) {
    tbody.innerHTML = '<tr><td colspan="4" class="text-center py-4 text-muted">Sin datos disponibles</td></tr>';
    return;
  }

  const medals = ['🥇', '🥈', '🥉'];
  tbody.innerHTML = data.data.map((m, i) => `
    <tr>
      <td><span style="font-size:20px;">${medals[i] || (i + 1)}</span></td>
      <td class="fw-semibold">${m.titulo}</td>
      <td><span class="badge bg-light text-dark">${m.tipo}</span></td>
      <td>
        <div class="d-flex align-items-center gap-2">
          <div class="progress flex-grow-1" style="height:6px;border-radius:3px;max-width:120px;">
            <div class="progress-bar" style="width:${Math.min(100, m._count.prestamos * 20)}%;background:var(--color-primary);"></div>
          </div>
          <span class="fw-semibold">${m._count.prestamos}</span>
        </div>
      </td>
    </tr>
  `).join('');
}
</script>