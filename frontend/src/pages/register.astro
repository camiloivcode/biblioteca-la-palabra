---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Solicitar Acceso">
  <div class="flex items-center justify-center min-h-screen p-margin-mobile md:p-0 relative overflow-hidden bg-surface">
    <div class="fixed inset-0 pointer-events-none -z-10"
      style="background: radial-gradient(circle at 20% 30%, #dbe1ff 0%, transparent 40%),
              radial-gradient(circle at 80% 70%, #b5d0fd 0%, transparent 40%),
              radial-gradient(circle at 50% 50%, #f7f9fb 0%, transparent 100%);">
    </div>
    <div class="floating-shape w-96 h-96 -top-20 -left-20 fixed pointer-events-none -z-10"
      style="border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%; background: rgba(37,99,235,0.05);">
    </div>
    <div class="floating-shape w-80 h-80 bottom-0 right-0 fixed pointer-events-none -z-10"
      style="border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%; background: rgba(37,99,235,0.05); animation-delay: -5s; animation-duration: 25s;">
    </div>

    <main class="w-full max-w-md">
      <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-xl flex flex-col items-center shadow-[0px_1px_3px_rgba(0,0,0,0.05),0px_20px_25px_-5px_rgba(0,0,0,0.1)]">
        <div class="mb-xl text-center">
          <div class="w-24 h-24 mb-md mx-auto rounded-2xl bg-on-secondary-fixed flex items-center justify-center">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="8.5" cy="7" r="4"></circle>
              <line x1="20" y1="8" x2="20" y2="14"></line>
              <line x1="23" y1="11" x2="17" y2="11"></line>
            </svg>
          </div>
          <h1 class="font-headline-md text-headline-md text-on-secondary-fixed tracking-tight">Solicitar Acceso</h1>
          <p class="font-body-md text-body-md text-secondary">Completa el formulario para solicitar tu registro</p>
        </div>

        <div id="register-error" class="w-full font-body-md text-body-md text-error bg-error-container p-3 rounded-lg mb-lg hidden">
          <span id="register-error-text"></span>
        </div>

        <div id="register-success" class="w-full font-body-md text-body-md text-tertiary bg-tertiary-fixed-dim p-4 rounded-lg mb-lg hidden">
          <span id="register-success-text"></span>
        </div>

        <form id="register-form" class="w-full space-y-lg">
          <div class="space-y-sm">
            <label class="block font-label-md text-label-md text-secondary uppercase tracking-wider" for="nombre">Nombre Completo</label>
            <div class="relative group">
              <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary transition-colors">person</span>
              <input class="w-full pl-10 pr-4 py-3 bg-surface rounded-lg border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all font-body-md text-body-md outline-none" id="nombre" name="nombre" placeholder="Tu nombre completo" required type="text" />
            </div>
          </div>
          <div class="space-y-sm">
            <label class="block font-label-md text-label-md text-secondary uppercase tracking-wider" for="email">Correo Electrónico</label>
            <div class="relative group">
              <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary transition-colors">mail</span>
              <input class="w-full pl-10 pr-4 py-3 bg-surface rounded-lg border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all font-body-md text-body-md outline-none" id="email" name="email" placeholder="tu@correo.com" required type="email" />
            </div>
          </div>
          <div class="space-y-sm">
            <label class="block font-label-md text-label-md text-secondary uppercase tracking-wider" for="telefono">Teléfono (opcional)</label>
            <div class="relative group">
              <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary transition-colors">phone</span>
              <input class="w-full pl-10 pr-4 py-3 bg-surface rounded-lg border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all font-body-md text-body-md outline-none" id="telefono" name="telefono" placeholder="+54 11 1234-5678" type="tel" />
            </div>
          </div>
          <div class="space-y-sm">
            <label class="block font-label-md text-label-md text-secondary uppercase tracking-wider" for="mensaje">Mensaje (opcional)</label>
            <div class="relative group">
              <textarea class="w-full pl-10 pr-4 py-3 bg-surface rounded-lg border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all font-body-md text-body-md outline-none resize-none" id="mensaje" name="mensaje" placeholder="Cuéntanos por qué necesitas acceso..." rows="3"></textarea>
              <span class="material-symbols-outlined absolute left-3 top-4 text-outline group-focus-within:text-primary transition-colors">edit_note</span>
            </div>
          </div>
          <button class="w-full bg-primary-container text-on-primary py-3 px-6 rounded-lg font-title-lg text-title-lg shadow-md hover:shadow-lg hover:bg-primary transition-all duration-200 active:scale-[0.98] flex items-center justify-center gap-2" type="submit" id="btn-submit">
            <span>Enviar solicitud</span>
            <span class="material-symbols-outlined">how_to_reg</span>
          </button>
        </form>

        <div class="mt-xl pt-lg border-t border-outline-variant w-full text-center">
          <p class="font-body-md text-body-md text-on-surface-variant">
            ¿Ya tienes una cuenta?
            <a class="text-primary font-bold hover:underline" href="/login">Iniciar sesión</a>
          </p>
        </div>
      </div>

      <div class="mt-lg text-center">
        <p class="font-label-md text-label-md text-secondary-fixed-dim">© 2024 Biblioteca Popular La Palabra</p>
      </div>
    </main>
  </div>

  <script src="../scripts/register.js"></script>
  <script is:inline>
    document.addEventListener('mousemove', function(e) {
      const shapes = document.querySelectorAll('.floating-shape');
      const x = e.clientX / window.innerWidth;
      const y = e.clientY / window.innerHeight;
      shapes.forEach(function(shape, index) {
        const speed = (index + 1) * 20;
        shape.style.transform = 'translate(' + (x * speed) + 'px, ' + (y * speed) + 'px)';
      });
    });
  </script>
</BaseLayout>
